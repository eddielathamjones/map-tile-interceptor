/* Mario: an 8-bit overworld. Tiled grass, coin trails, pixel roads.
   Rules live in _mario.mcss; this file picks the tiles and colours. */

@vibe { label: "Mario"; order: 3; font: "Press Start 2P Regular"; sprite: mario; }
@import "_shared.mcss";
@import "_mario.mcss";

:root {
  --ground:      #38a800;
  --ground-tile: "fx:mario-grass";
  --park:        #80d010;
  --court:       #d8a060;
  --court-tile:  "fx:mario-court";
  --wood-tile:   "fx:mario-trees";
  --sand-tile:   "fx:mario-sand";
  --water:       #5c94fc;
  --water-tile:  "fx:mario-water";
  --water-halo:  #2038ec;
  --road:        #fcd8a8;
  --road-tile:   "fx:mario-road";
  --path-tile:   fx:mario-road;      /* sidewalks; no quotes, it is spliced into an expression */
  --highway:     #c84c0c;
  /* buildings: plaster by default; the menu's Effects section also offers
     hard block, castle stone and brick (see MARIO_BLOCKS in fx.js) */
  --building:      #f8d0a0;
  --building-tile: "fx:mario-plaster";
  --building-edge: #c08040;
  --black:       #000000;
  --white:       #ffffff;
}

raster { maxzoom: unset; opacity: zoom(4 0.7, 8 0.35, 10 0); }
