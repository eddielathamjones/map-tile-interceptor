/* Hi-Contrast — an accessibility style, not a look. Black ground, white
   outlines, yellow roads, large white labels with heavy black halos. */

@vibe { label: "Hi-Contrast"; order: 20; font: "Atkinson Hyperlegible Regular"; }

:root { --black: #000000; --white: #ffffff; --yellow: #ffee00; --blue: #0044ff; --green: #00a040; }

background { color: var(--black); }
raster     { display: none; }

.pattern, landuse, landcover, aeroway.fill, park.outline { display: none; }
#park        { color: #002a10; opacity: 1; }
#park::after { type: line; color: var(--green); width: 1.5; }

water        { color: var(--blue); }
water::after { type: line; color: var(--white); width: 1.5; }
waterway     { color: var(--blue); }

road.casing        { color: var(--black); }
road:not(.casing)  { color: var(--yellow); opacity: 1; }
road.minor:not(.casing), road.service, road.path { color: #b8ac00; }
rail               { color: var(--white); }
boundary           { color: var(--white); dash: 6 3; }

#building          { color: var(--black); outline: var(--white); maxzoom: unset; }
#building::after   { type: line; color: var(--white); width: zoom(14 0.6, 17 1.4); }
building.extrusion { display: none; }

label        { color: var(--white); halo: var(--black) 2.5; }
label.road   { size: zoom(13 12, 16 16); }
label.place  { size: zoom(4 14, 10 18, 14 22); }
label.poi    { size: 13; text-offset: 0 1.0; }
label.shield { color: var(--black); halo: unset; }
