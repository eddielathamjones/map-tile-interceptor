/* Tom Clancy — phosphor-green tactical display. Dark ground, roads as the
   only bright thing on screen, brightness = importance. */

@vibe { label: "Tom Clancy"; order: 4; font: "Share Tech Mono Regular"; sprite: tomclancy; }

:root {
  --void:   #010a03;
  --p1:     #052a0e;   /* dimmest phosphor */
  --p2:     #0a5c20;
  --p3:     #10a53a;
  --p4:     #00d93f;
  --p5:     #00ff41;   /* full brightness */
}

background { color: var(--void); }
raster     { maxzoom: unset; opacity: zoom(2 0.55, 6 0); }

/* ── Ground: barely there ── */
.pattern, landuse, landcover.wetland, landcover.sand, landcover.ice { display: none; }
park, #landcover_grass { color: #03200b; opacity: 1; }
park.outline           { color: var(--p2); dash: 2 3; }
#landcover_wood        { color: #042a0e; opacity: 1; }
aeroway.fill           { color: var(--p1); }
aeroway.line           { color: var(--p3); }

/* ── Water: hatched void with a bright shoreline ── */
water        { color: var(--void); pattern: "fx:tc-scan"; }
water::after { type: line; color: var(--p4); width: zoom(4 0.5, 12 1, 16 1.5); }
waterway     { color: var(--p3); }

/* ── Roads: brightness ladder, glow on the arterials ── */
road.casing                 { display: none; }
road:not(.casing)           { color: var(--p2); }
road.secondary:not(.casing), road.link:not(.casing) { color: var(--p3); }
road.trunk:not(.casing)     { color: var(--p4); }
road.motorway:not(.casing)  { color: var(--p5); }
road.trunk:not(.casing)::before, road.motorway:not(.casing)::before
                            { color: var(--p5); opacity: 0.3; blur: 5;
                              width: zoom(exp 1.4, 5 3, 10 8, 14 18, 18 44); }
road.path                   { color: var(--p2); dash: 2 2; }
rail                        { color: var(--p3); dash: 5 3; }
rail.hatching               { display: none; }
boundary                    { color: var(--p4); dash: 6 3; opacity: 0.7; }

/* ── Buildings: wireframe ── */
#building          { color: #021405; outline: var(--p2); }
#building::after   { type: line; color: var(--p3); width: zoom(14 0.5, 17 1.1); }
building.extrusion { color: json(["interpolate", ["linear"], ["get", "render_height"],
                                  0, "#03240c", 60, "#0a5c20"]);
                     opacity: 0.75; }

/* ── Labels ── */
label        { color: var(--p5); halo: var(--void) 1.5; transform: uppercase; spacing: 0.08; }
label.road   { color: #29c552; size: zoom(13 9, 16 11); }
label.water  { color: var(--p3); }
label.poi    { color: #29c552; text-offset: 0 1.2; size: 9; }
#poi_transit { text-offset: 1.1 0; }
label.shield { color: var(--p5); halo: unset; size: 9; icon-scale: 2;
               text-anchor: center; text-offset: 0 0.25; }

/* The custom icon sheet is small: fall back to a dot for anything it lacks. */
.arrow       { display: none; }
label.poi    { icon: json(["coalesce", ["image", ["get", "class"]], ["image", "dot_10"]]); }
#label_village, #label_town, #label_city, #label_city_capital
             { icon: json(["step", ["zoom"], "dot_9", 9, ""]); }
