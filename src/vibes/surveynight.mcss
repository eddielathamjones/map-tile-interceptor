@vibe { label: "Survey Night"; order: 0.5; font: "Barlow Medium"; }

:root {
  --ground:        #0C172D;   /* midnight */
  --card:          #13213D;
  --primary:       #869FCB;   /* lift */
  --text:          #F2EDE1;
  --text-dim:      #AEB6C6;
  --accent:        #E8B13A;
  --accent-edge:   #0C172D;
  --water:         #071022;
  --water-edge:    #2350A0;
  --water-text:    #869FCB;
  --green:         #14301F;
  --green-edge:    #3F6B35;
  --wood:          #1B3B24;
  --sand:          #2A2A22;
  --road:          #3A4A6C;
  --road-edge:     #0C172D;
  --rail:          #6B7690;
  --building:      #13213D;
  --building-edge: #22304D;
  --contours:      "fx:svn-contours";
  --icons:         fx:svn-;
}

@import "_survey.mcss";
