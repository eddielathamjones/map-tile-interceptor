/* Survey — the main register of the ELJ brand ("mid-century atlas").
   Shared by survey.mcss (light) and surveynight.mcss (dark): set the tokens
   in :root, then @import this file. */

background { color: var(--ground); pattern: var(--contours); }
raster     { display: none; }

/* ── Ground ── */
.pattern, landuse, landcover.wetland, aeroway.fill { display: none; }
#landuse_cemetery, #landuse_pitch { display: visible; color: var(--green); }
park, #landcover_grass { color: var(--green); opacity: 1; }
park.outline           { color: var(--green-edge); }
#landcover_wood        { color: var(--wood); opacity: 1; }
#landcover_sand        { color: var(--sand); }
#landcover_ice         { color: var(--card); }
aeroway.line           { color: var(--road-edge); }

/* ── Water ── */
water        { color: var(--water); }
water::after { type: line; color: var(--water-edge); width: zoom(4 0.5, 12 1, 16 1.5); }
waterway     { color: var(--water-edge); }

/* ── Roads: card-white ribbons with a hairline edge; one accent for the big ones ── */
road         { cap: round; join: round; }
road.casing  { color: var(--road-edge); }
road:not(.casing)          { color: var(--road); }
road.secondary:not(.casing), road.link:not(.casing) { color: var(--road); }
road.trunk:not(.casing), road.motorway:not(.casing) { color: var(--accent); }
road.trunk.casing, road.motorway.casing             { color: var(--accent-edge); }
road.path                  { color: var(--primary); dash: 2 2; }
road.path.casing           { display: none; }
rail                       { color: var(--rail); }
boundary                   { color: var(--primary); dash: 6 2 1 2; opacity: 0.8; }

/* ── Buildings ── */
#building          { color: var(--building); outline: var(--building-edge); }
building.extrusion { color: var(--building); opacity: 0.9; }

/* ── Lettering: condensed caps for places, Barlow for everything else ── */
label        { color: var(--text); halo: var(--ground) 1.6; }
label.place  { font: "Barlow Condensed SemiBold"; color: var(--primary);
               transform: uppercase; spacing: 0.08; }
label.city   { color: var(--text); size: zoom(4 13, 8 18, 12 24); }
label.water  { color: var(--water-text); halo: var(--water) 1.2; spacing: 0.06; }
label.road   { color: var(--text-dim); }
label.shield { color: var(--text); halo: unset; }

label.poi    { color: var(--text-dim); text-offset: 0 1.0;
               icon: json(["coalesce", ["image", ["concat", "var(--icons)", ["get", "class"]]],
                                       ["image", "var(--icons)dot"]]); }
#poi_transit { text-offset: 1.0 0; }
#airport     { icon: "var(--icons)airport"; }

/* the brand's one pin marks the cities */
#label_city, #label_city_capital
             { icon: json(["step", ["zoom"], "fx:sv-pin", 9, ""]); icon-anchor: bottom; icon-scale: 0.8; }
