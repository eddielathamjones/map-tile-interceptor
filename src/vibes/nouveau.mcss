/* Art Nouveau — a Mucha-poster Paris. Cream paper, terracotta blocks,
   peacock water, absinthe gardens, gold boulevards, and a dark ink line
   around everything like the leading of a stained-glass window. */

@vibe { label: "Nouveau"; order: 2; font: "Federo Regular"; }
@import "_shared.mcss";

:root {
  --paper:      #efe2c2;
  --ink:        #3d2a20;
  --sienna:     #8a4f3a;
  --terracotta: #d99c7c;
  --peacock:    #4f8f88;
  --absinthe:   #a9b56a;
  --olive:      #5e6b2e;
  --gold:       #e0ac3e;
  --straw:      #f0d488;
  --cream:      #fbf3dc;
}

background { color: var(--paper); }
/* relief carries the region view; parks fade in so Arizona is not a green flood */
raster     { maxzoom: unset; opacity: zoom(4 0.55, 8 0.35, 10 0); }

/* ── Ground ── */
.pattern, landcover.wetland { display: none; }
landuse              { color: #e3cfa0; }
#landuse_residential { color: #ead7ac; }
#landuse_cemetery    { color: #b7b98a; }
aeroway.fill         { color: #e0d2b0; }
aeroway.line         { color: var(--cream); }
#landcover_grass     { color: #b9c078; opacity: 1; }
#landcover_wood      { color: #8a9a52; opacity: 1; }
#landcover_sand      { color: #e6cf96; }
#landcover_ice       { color: #f4efe0; }

#park                { pattern: "fx:nouveau-leaves"; opacity: zoom(5 0.45, 9 1); }
#park::after         { type: line; color: var(--olive); width: zoom(10 0.6, 14 1.4, 18 2.2); }
park.outline         { display: none; }

/* ── Water: whiplash wave lines, inked bank ── */
water        { color: var(--peacock); pattern: "fx:nouveau-waves"; }
/* drawn under the water fill at double width: the land-side half shows on
   shorelines, while seams between water polygons (river meets bay) stay hidden */
water::before { type: line; color: var(--ink); width: zoom(4 1, 10 2, 15 4); }
/* rivers drawn as a sinuous stem, like the whiplash lines in a Mucha border */
waterway     { color: var(--peacock); pattern: "fx:nv-stem"; width: zoom(6 2, 10 4, 14 8, 18 14); }

/* ── Streets: cream and gold glass, ink leading ── */
road.casing                 { color: var(--ink); }
road:not(.casing)           { color: var(--cream); }
road.secondary:not(.casing), road.link:not(.casing) { color: var(--straw); }
road.trunk:not(.casing), road.motorway:not(.casing) { color: var(--gold); }
road.path                   { color: var(--sienna); }
road.path.casing            { color: var(--paper); }
rail                        { color: var(--ink); }
boundary                    { color: var(--sienna); }

/* ── Buildings: glass, not brick ──
   Dense blocks (Manhattan is mostly roof) turned solid terracotta and buried
   the paper and the leading. Footprints are now a pale, translucent wash with
   a fine ink line, so the city reads as a stained-glass window. */
#building          { color: #eab89a; opacity: 0.55; outline: var(--sienna); }
#building::after   { type: line; color: var(--ink); minzoom: 15; opacity: 0.55;
                     width: zoom(15 0.3, 17 0.9, 18 1.3); }
/* 3D: a mosaic of light tesserae, terracotta, rose, ochre and sienna */
building.extrusion { color: json(["match", ["%", ["to-number", ["id"], 0], 4],
                                  0, "#efc3a5", 1, "#ebb9a4", 2, "#edcc93", "#dcaa8c"]);
                     opacity: 1; }

/* ── Lettering ── */
label        { color: var(--ink); halo: var(--paper) 1.4; }
label.place  { font: "Glass Antiqua Regular"; spacing: 0.04; }
/* Mucha's halo: a gilded disc behind every major place name */
#label_city, #label_city_capital
             { icon: "fx:nv-nimbus"; icon-scale: zoom(4 0.42, 8 0.55, 12 0.75); }
label.water  { color: #f3ead0; halo: #2f6660 1.4; spacing: 0.1; }
label.road   { size: zoom(13 9, 16 13); }
label.shield { icon: json(["concat", "fx:nv-shield-", ["get", "ref_length"]]); icon-scale: 1; color: var(--ink); halo: unset; }

label.poi    { icon: json(["coalesce", ["image", ["concat", "fx:nv-", ["get", "class"]]],
                                       ["image", "fx:nouveau-dot"]]);
               text-offset: 0 1.0; }
#poi_transit { icon: json(["match", ["get", "class"], "railway", "fx:nouveau-metro",
                           ["coalesce", ["image", ["concat", "fx:nv-", ["get", "class"]]],
                                        ["image", "fx:nouveau-dot"]]]);
               text-offset: 1.0 0; }
#airport     { icon: "fx:nv-airport"; }
